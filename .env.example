# ─── Sanity ──────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Until NEXT_PUBLIC_SANITY_PROJECT_ID is set the
# site runs on the placeholder content in lib/content/seed.json and /studio
# shows a setup notice instead of the Studio.

# From `npx sanity@latest projects create`, or the project's manage page.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Pinning this freezes the API's behaviour. Only change it deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-24

# Shared secret on the revalidation webhook. Generate one and paste the same
# value into the webhook's "Secret" field in sanity.io/manage:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it POST /api/revalidate refuses every request, and content changes
# only appear on the hourly fallback.
SANITY_REVALIDATE_SECRET=

# Lets Chapter .06's contact form write `message` documents into the dataset.
# Create one at sanity.io/manage > API > Tokens with the "Editor" role, and keep
# it out of anything NEXT_PUBLIC_: the read client is in the browser bundle by
# way of coverSrc(), and a write token there would be a public write token.
# Without this the form validates, refuses politely, and logs the reason.
SANITY_API_WRITE_TOKEN=
